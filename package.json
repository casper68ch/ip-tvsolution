{
  "name": "ip-tv-solution",
  "version": "1.0.0",
  "private": true,
  "description": "Portale italiano per l'installazione di player IPTV legittimi: nessun contenuto, nessuna playlist, nessuna credenziale.",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=1024 next dev",
    "prebuild": "node scripts/validate-apps.mjs",
    "build": "next build",
    "start": "node scripts/serve-out.mjs",
    "deploy": "npm run build && cd .. && npx --yes wrangler pages deploy \"ip-tv-solution/out\" --project-name ip-tvsolution --branch main",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-apps.mjs"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.8",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "cross-env": "^10.1.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2"
  }
}
